ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES = AppIcon-light AppIcon-eggshell-white AppIcon-linen AppIcon-sea-glass AppIcon-heritage AppIcon-oled AppIcon-dark AppIcon-ember AppIcon-midnight-cherry AppIcon-forest AppIcon-nord AppIcon-deep-ocean AppIcon-vscode-blue AppIcon-cobalt-coral AppIcon-signal-blue AppIcon-tokyo-night AppIcon-amethyst AppIcon-dracula
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_STYLE = Automatic
